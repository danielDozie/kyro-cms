{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../packages/core/src/index.ts", "../admin/src/index.ts"],
  "entryPointStrategy": "expand",
  "out": "./api-reference",
  "name": "Kyro CMS API",
  "includeVersion": true,
  "readme": "./api-readme.md",
  "sidebar": {
    "collapse": false
  },
  "comment": {
    "tag": "inline",
    "noAuthor": true
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test/**",
    "**/examples/**"
  ],
  "excludeNotDocumented": true,

  "visibilityFilters": {
    "externSymbol": false,
    "private": false,
    "protected": false,
    "package": false
  },

  "plugin": ["typedoc-plugin-versions"],

  "theme": "markdown",

  "customFooterLinks": {
    "GitHub": "https://github.com/danielDozie/kyro-cms",
    "npm": "https://www.npmjs.com/package/@kyro-cms/core"
  }
}
