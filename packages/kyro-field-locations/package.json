{
  "name": "@kyro-cms/field-locations",
  "version": "0.12.72",
  "description": "Locations field extension for Kyro CMS with Mapbox, Google Maps, OpenStreetMap, MapLibre GL, and Photon geocoding support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@kyro-cms/core": "workspace:*"
  },
  "devDependencies": {
    "@kyro-cms/core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
