{
  "name": "kyro-field-locations",
  "version": "0.12.44",
  "description": "Pre-built geographic SelectFields for Kyro CMS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@kyro-cms/core": "workspace:*"
  },
  "devDependencies": {
    "@kyro-cms/core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
