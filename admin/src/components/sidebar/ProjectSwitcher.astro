---
import * as Icons from "lucide-react";
import { adminPath } from "../../lib/paths";
import { getActiveProjectFromRequest } from "../../lib/config";
interface ProjectItem { id?: string; name: string; environment?: string; collections?: string[]; orgName?: string }
interface OrganizationItem { name: string; projects?: ProjectItem[] }
interface Props { organizations: OrganizationItem[]; projects: ProjectItem[]; allProjects: ProjectItem[]; canManage?: boolean }
const { organizations = [], projects = [], allProjects = [], canManage = false } = Astro.props;
const activeProject = getActiveProjectFromRequest(Astro.request);
const initial = activeProject || allProjects[0];
const groups = [...organizations.map(org => ({ name: org.name, projects: (org.projects || []).map(project => ({ ...project, orgName: org.name })) })), ...(projects.length ? [{ name: organizations.length ? "Other projects" : "Projects", projects: projects.map(project => ({ ...project, orgName: "" })) }] : [])];
---
{groups.length > 0 && <div class="sidebar-tenancy-box project-picker">
  <button type="button" id="project-switcher-btn" class="project-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="project-switcher-menu">
    <span class="project-picker-mark" aria-hidden="true"><Icons.Building2 className="w-4 h-4" /></span>
    <span class="project-picker-current"><span id="active-project-org" class="sr-only">{initial?.orgName || "Workspace"}</span><strong id="active-project-name">{initial?.name || organizations[0]?.name || "Workspace"}</strong><small id="active-project-env" class="sr-only">{initial?.environment || "Production"}</small></span>
    <Icons.ChevronsUpDown className="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
  </button>
  <div id="project-switcher-backdrop" class="project-picker-backdrop hidden" aria-hidden="true"></div>
  <div id="project-switcher-menu" class="project-picker-menu hidden" role="dialog" aria-label="Switch project">
    <div class="project-picker-top"><strong>Switch project</strong>{canManage && <a href={`${adminPath}/workspaces`}>View all ↗</a>}</div>
    <label class="sr-only" for="project-picker-search">Find an organization or project</label><input id="project-picker-search" type="search" placeholder="Find a project…" autocomplete="off" />
    <div class="project-picker-groups">{groups.map(group => <section data-project-group><h3>{group.name}<span>{group.projects.length}</span></h3>{group.projects.map(project => <button type="button" class="project-switcher-item" data-project-row data-project-choice data-proj-key={project.id || `${project.orgName}/${project.name}`} data-proj-id={project.id || ""} data-proj-name={project.name} data-proj-org={project.orgName || ""} data-proj-env={project.environment || "Production"} data-proj-collections={JSON.stringify(project.collections || [])}>
      <span><strong>{project.name}</strong><small title={project.environment || "Production"}>{(project.environment || "production").slice(0, 4)}</small></span><span class="project-choice-check" aria-hidden="true">✓</span>
    </button>)}</section>)}</div>
    <p id="project-picker-empty" class="hidden">No projects match this search.</p>
  </div>
</div>}
