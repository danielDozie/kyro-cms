---
import * as Icons from "lucide-react";
import i18next from "../../lib/i18n";
import SidebarNavItem, { type NavItem } from "./SidebarNavItem.astro";
export interface NavSection { label: string; items: NavItem[] }
interface Props { navSections: NavSection[]; adminPath: string; currentPath: string; pageTitle: string }
const { navSections, adminPath, currentPath, pageTitle } = Astro.props;
const sectionText = (label: string) => label === "Settings"
  ? i18next.t("nav.administration", { defaultValue: "Administration" })
  : i18next.t(label, { defaultValue: label.split(".").pop() || label });
---
<nav id="sidebar-nav" aria-label="Main navigation">
  <div class="sidebar-nav-groups">
    {navSections.map((section, index) => (
      <section class="sidebar-nav-section group/section" data-section={section.label} data-sidebar-tree={section.label !== "Dashboard" ? "true" : "false"}>
        {section.label !== "Dashboard" && <div class="sidebar-folder-heading">
          <button type="button" class="sidebar-section-toggle" aria-expanded="true" aria-controls={`sidebar-section-${index}`} aria-label={sectionText(section.label)} title={sectionText(section.label)}>
            <Icons.ChevronRight className="sidebar-folder-chevron" size={12} aria-hidden="true" />
            {section.label === "Settings" ? <Icons.Settings2 className="sidebar-folder-icon" size={15} aria-hidden="true" /> : <Icons.Folder className="sidebar-folder-icon" size={15} aria-hidden="true" />}
            <span class="sidebar-text sidebar-folder-label">{sectionText(section.label)}</span>
          </button>
        </div>}
        <ul id={`sidebar-section-${index}`} class="section-items" aria-label={section.label === "Dashboard" ? "Workspace" : sectionText(section.label)}>
          {section.items.map(item => <li><SidebarNavItem item={item} adminPath={adminPath} currentPath={currentPath} pageTitle={pageTitle}/></li>)}
        </ul>
      </section>
    ))}
  </div>
</nav>
