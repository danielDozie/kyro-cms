---
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { UserMenu } from "../UserMenu";
interface Props { adminPath: string }
const { adminPath } = Astro.props;
---
<div class="sidebar-footer mt-auto">
  <div class="sidebar-footer-inner">
    <ThemeSwitcher />
    <div class="sidebar-footer-actions">
      <UserMenu client:only="react" adminPath={adminPath} />
      <button id="logout-btn" class="hidden"></button>
      <button id="sidebar-panel-toggle" type="button" class="sidebar-collapse-control hidden md:flex" title="Collapse sidebar" aria-label="Collapse sidebar" aria-controls="sidebar-nav" aria-expanded="true">
        <svg class="sidebar-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18m7-13-4 4 4 4"/></svg>
        <span class="sidebar-collapse-label sr-only">Collapse sidebar</span>
      </button>
    </div>
  </div>
</div>
