---
import "../styles/main.css";
import { nonAuthCollections, projects, organizations } from "../lib/config";
import { adminPath } from "../lib/paths";
import { getSiteSettings, getBrandSettings } from "../lib/globals";
import { getAuthServer } from "../lib/auth-server";

import SidebarHeader from "./sidebar/SidebarHeader.astro";
import ProjectSwitcher from "./sidebar/ProjectSwitcher.astro";
import SidebarNav, { type NavSection } from "./sidebar/SidebarNav.astro";
import SidebarFooter from "./sidebar/SidebarFooter.astro";
import type { NavItem } from "./sidebar/SidebarNavItem.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// Site & Branding configuration
const siteSettings = await getSiteSettings({ request: Astro.request });
const brandSettings = await getBrandSettings({ request: Astro.request });

const siteName = siteSettings?.siteName || brandSettings?.companyInfo?.companyName || "KYRO.";
const siteLogo = brandSettings?.identity?.primaryLogo;
const darkLogo = brandSettings?.identity?.darkLogo;
const logoWidth = siteLogo?.width || darkLogo?.width;
const logoHeight = siteLogo?.height || darkLogo?.height;
const logoAlt = siteLogo?.altText || darkLogo?.altText || siteName;
const showSiteName = brandSettings?.identity?.showSiteName ?? true;

// Tenancy / Projects
const allProjects = [
  ...projects,
  ...organizations.flatMap((org) => (org.projects || []).map((p) => ({ ...p, orgName: org.name }))),
];

// Dynamic collections grouped by folder/group
const groupedCollections = new Map<string, NavItem[]>();

nonAuthCollections
  .filter((col) => col.slug !== "media")
  .forEach((col) => {
    const item: NavItem = {
      href: `${adminPath}/${col.slug}`,
      label: col.label || col.slug,
      icon: (col.admin?.icon as string) || "collection",
      order: typeof col.admin?.order === "number" ? col.admin.order : 999,
    };

    const groupName = (col.folder || col.admin?.folder || col.admin?.group || "Content") as string;
    if (!groupedCollections.has(groupName)) {
      groupedCollections.set(groupName, []);
    }
    groupedCollections.get(groupName)!.push(item);
  });

const dynamicSections: NavSection[] = Array.from(groupedCollections.entries())
  .map(([group, items]) => {
    const sortedItems = items.sort((a, b) => (a.order || 999) - (b.order || 999));
    const minOrder = sortedItems.length > 0 ? (sortedItems[0].order ?? 999) : 999;
    return {
      label: group,
      items: sortedItems,
      minOrder,
    };
  })
  .sort((a, b) => a.minOrder - b.minOrder)
  .map(({ label, items }) => ({ label, items }));

// Server-side auth & RBAC resolution
const { user: serverUser, permissions: serverPermissions } = await getAuthServer(Astro.request);
const serverRole = serverUser?.role || "";
const isServerSuperAdmin = serverRole === "super_admin";
const isServerAdmin = serverRole === "admin" || isServerSuperAdmin;
const isServerEditor = serverRole === "editor";
const isServerAuthor = serverRole === "author";
const isServerCustomer = serverRole === "customer";

const navSectionsRaw: NavSection[] = [
  {
    label: "Dashboard",
    items: [
      { href: adminPath, label: "nav.dashboard", icon: "home" },
      {
        href: adminPath + "/media",
        label: "nav.media",
        icon: "media",
      },
    ],
  },
  ...dynamicSections,
  {
    label: "Settings",
    items: [
      { href: adminPath + "/users", label: "nav.users", icon: "users" },
      {
        href: adminPath + "/settings",
        label: "nav.settings",
        icon: "settings",
      },
    ],
  },
];

const navSections: NavSection[] = navSectionsRaw
  .map((section) => {
    if (!serverUser) return section;
    const items = section.items.filter((item) => {
      const slug = item.href.split("/").pop() || "";
      if (item.href === adminPath) return true;
      if (slug === "roles") return isServerSuperAdmin;
      if (slug === "plugins" || slug === "keys" || slug === "webhooks" || slug === "settings") return isServerAdmin;
      if (slug === "users") return isServerAdmin || serverPermissions?.collections?.users?.read === true;
      if (slug === "audit" || slug === "audit_logs")
        return isServerAdmin || serverPermissions?.collections?.audit_logs?.read === true;
      if (slug === "media")
        return (
          !isServerCustomer &&
          (isServerAdmin || isServerEditor || isServerAuthor || serverPermissions?.collections?.media?.read === true)
        );

      if (isServerAdmin) return true;
      if (serverPermissions?.collections?.[slug]) {
        return serverPermissions.collections[slug].read === true;
      }

      if (isServerEditor) {
        return !["users", "audit_logs", "roles", "plugins", "keys", "webhooks", "settings"].includes(slug);
      }
      if (isServerAuthor) {
        return ["posts", "categories", "orders"].includes(slug);
      }
      if (isServerCustomer) {
        return ["orders"].includes(slug);
      }
      return false;
    });
    return { ...section, items };
  })
  .filter((section) => section.items.length > 0);
---

<aside
  id="kyro-sidebar"
  class="surface-tile rounded-r-lg rounded-l-none md:rounded-l-lg w-[280px] flex flex-col flex-shrink-0 fixed md:static inset-y-0 left-0 z-50 md:z-auto transition-transform duration-300 -translate-x-full md:translate-x-0 h-[100dvh] md:h-auto border-r border-[var(--kyro-border)]"
>
  <SidebarHeader
    siteLogo={siteLogo}
    darkLogo={darkLogo}
    logoWidth={logoWidth}
    logoHeight={logoHeight}
    logoAlt={logoAlt}
    showSiteName={showSiteName}
    siteName={siteName}
  />

  <ProjectSwitcher
    organizations={organizations}
    projects={projects}
    allProjects={allProjects}
  />

  <SidebarNav
    navSections={navSections}
    adminPath={adminPath}
    currentPath={currentPath}
    pageTitle={title}
  />

  <SidebarFooter adminPath={adminPath} />
</aside>

<script>
  import { adminPath } from "../lib/paths";
  import { setupSidebar } from "./sidebar/sidebar-client";

  setupSidebar(adminPath);
</script>

<style is:global>
  #kyro-sidebar {
    transition:
      width 300ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    overflow-x: hidden !important;
  }

  #kyro-sidebar #sidebar-nav {
    overflow-x: hidden !important;
  }

  /* Collapsed Rail State */
  #kyro-sidebar[data-minimized="true"] {
    width: 76px !important;
    min-width: 76px !important;
    max-width: 76px !important;
    overflow-x: hidden !important;
  }
  #kyro-sidebar[data-minimized="true"] #sidebar-nav,
  #kyro-sidebar[data-minimized="true"] #sidebar-nav > div,
  #kyro-sidebar[data-minimized="true"] #sidebar-nav .group\/section,
  #kyro-sidebar[data-minimized="true"] #sidebar-nav .section-items {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow-x: hidden !important;
    box-sizing: border-box !important;
  }
  #kyro-sidebar[data-minimized="true"] #sidebar-nav::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  #kyro-sidebar[data-minimized="true"] .sidebar-header {
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-top: 1rem !important;
    padding-bottom: 0.75rem !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.5rem !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-brand {
    justify-content: center !important;
    width: 100% !important;
    margin: 0 auto !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-brand > div {
    justify-content: center !important;
    width: 100% !important;
    margin: 0 auto !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-brand img {
    margin: 0 auto !important;
    width: 28px !important;
    height: 28px !important;
    max-width: 28px !important;
    max-height: 28px !important;
  }

  /* Hide text, section headers, and workspace switcher cleanly */
  #kyro-sidebar[data-minimized="true"] .sidebar-text,
  #kyro-sidebar[data-minimized="true"] .sidebar-section-toggle,
  #kyro-sidebar[data-minimized="true"] .sidebar-tenancy-box,
  #kyro-sidebar[data-minimized="true"] [data-section] > div:first-child {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    opacity: 0 !important;
    overflow: hidden !important;
    visibility: hidden !important;
    font-size: 0 !important;
    line-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  /* Center Nav Item Buttons and force Icons to be visible & perfectly centered */
  #kyro-sidebar[data-minimized="true"] a[data-nav-item] {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0 !important;
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    max-width: 28px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    margin-top: 8px !important;
    margin-bottom: 4px !important;
    border-radius: 5px !important;
    padding: 8px !important;
  }

  #kyro-sidebar[data-minimized="true"] .nav-icon-wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #kyro-sidebar[data-minimized="true"] .sidebar-icon-expanded {
    display: none !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-icon-collapsed {
    display: block !important;
  }

  /* Footer & User Menu Rail alignment for Collapsed State */
  #kyro-sidebar[data-minimized="true"] .sidebar-footer {
    padding: 0.75rem 0 !important;
    margin-top: auto !important;
    width: 100% !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-footer-inner {
    display: flex !important;
    flex-direction: column-reverse !important;
    gap: 0.625rem !important;
    padding: 0 !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    width: 100% !important;
  }
  #kyro-sidebar[data-minimized="true"] .theme-toggle-box {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.25rem !important;
    padding: 0.25rem !important;
    width: 32px !important;
    margin: 0 auto !important;
    border-radius: 8px !important;
  }
  #kyro-sidebar[data-minimized="true"] #theme-light-btn,
  #kyro-sidebar[data-minimized="true"] #theme-dark-btn {
    width: 24px !important;
    height: 24px !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 6px !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-footer-inner > div.flex {
    width: 100% !important;
    justify-content: center !important;
    gap: 0 !important;
  }
  #kyro-sidebar[data-minimized="true"] .sidebar-footer-inner [title*="Account"],
  #kyro-sidebar[data-minimized="true"] .sidebar-footer-inner div[class*="items-center"][class*="justify-center"] {
    width: 32px !important;
    height: 32px !important;
    margin: 0 auto !important;
    border-radius: 8px !important;
  }
</style>
