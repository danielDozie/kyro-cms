---
import AdminLayout from "../../layouts/AdminLayout.astro";
import i18next from "../../lib/i18n";
import { collections, resolveProjectCollectionAccess } from "../../lib/config";
import { AutoForm } from "../../components/AutoForm";
import { CompactListView } from "../../components/CompactListView";
import { adminPath, apiPath } from "../../lib/paths";

import { isStudioCollection, studioCollectionUrl } from "../../lib/studio";
const { collection, id } = Astro.params;
const studio = false;
if (studio && (!collection || !collections[collection] || !isStudioCollection(collections[collection]))) return Astro.redirect(`${adminPath}/studio`);

// Validate collection exists
// Workaround for Astro route overlap: if 'settings' hits the dynamic collection route
const isSettings = collection === "settings";
let config: any;
let isNew: boolean = false;
let title: string = "";

if (!isSettings) {
  if (!collection || !collections[collection]) {
    return Astro.redirect(adminPath);
  }

  const projectAccess = resolveProjectCollectionAccess(collection, Astro.request);
  if (!projectAccess.allowed && projectAccess.redirectTo) {
    return Astro.redirect(projectAccess.redirectTo);
  }
  if (projectAccess.setCookieHeader) {
    Astro.response.headers.set("Set-Cookie", projectAccess.setCookieHeader);
  }

  config = collections[collection];
  isNew = !id || id === "new";
  title = isNew
    ? `Create ${config.singularLabel || config.label || collection}`
    : `Edit ${config.singularLabel || config.label || collection}`;
}

import { requireAuthServer } from "../../lib/auth-server";

if (collection) {
  const reqOp = !id || id === "new" ? "collectionCreate" : "collectionRead";
  const redirect = await requireAuthServer(Astro.request, { [reqOp]: collection });
  if (redirect) return redirect;
}

let docs: any[] = [];
let totalDocs = 0;
const searchParam = Astro.url.searchParams.get("search") || "";

if (!isSettings) {
  try {
    let fetchUrl = `${Astro.url.origin}${apiPath}/${collection}?page=1&limit=20&depth=1&draft=true&t=${Date.now()}`;
    if (searchParam) {
      // Basic extraction of title field for the where query
      const titleF = typeof config.admin?.useAsTitle === "string" 
        ? config.admin.useAsTitle 
        : config.fields?.find((f: any) => f.type !== "group" && typeof f.name === "string")?.name;
      
      if (titleF) {
        const whereObj = { [titleF]: { contains: searchParam } };
        fetchUrl += `&where=${encodeURIComponent(JSON.stringify(whereObj))}`;
      }
    }
    const response = await fetch(
      fetchUrl,
      {
        headers: Astro.request.headers,
        credentials: "include",
      },
    );
    if (response.ok) {
      const data = await response.json();
      docs = data.docs || [];
      totalDocs = data.totalDocs || 0;
    }
  } catch (error) {
    console.error("Failed to fetch documents:", error);
  }
}


import SettingsPageAstro from "../settings/[slug].astro";
---

{
  isSettings ? (
    <SettingsPageAstro slug={id} />
  ) : (
    <AdminLayout title={title}>
      <div class:list={[studio && "studio-editor", "editor-workspace flex flex-col h-full w-full min-w-0"]}>
        {studio && <nav class="studio-editor-trail" aria-label="Studio breadcrumb"><a href={`${adminPath}/studio`}>Studio</a><span>/</span><a href={studioCollectionUrl(adminPath, collection!)}>{config.label || collection}</a><span>/</span><span>{isNew ? "New document" : "Edit document"}</span></nav>}
        <details class="editor-browser" id="editor-browser-details">
          <summary>Browse {config.label || collection} <svg class="editor-browser-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
          <div class="editor-browser-backdrop" id="editor-browser-backdrop" aria-hidden="true"></div>
          <div class="editor-browser-panel">
          <CompactListView
            client:only="react"
            collection={config}
            studio={studio}
            collectionSlug={collection}
            initialDocs={docs}
            initialTotal={totalDocs}
            activeId={!isNew ? id : undefined}
            initialSearch={searchParam}
          />
          </div>
        </details>

        {/* Right Pane: Document Editor */}
        <div class="flex-1 min-h-0 min-w-0 overflow-y-auto">
          <div class="mx-auto space-y-6 pb-12 px-0 md:px-0">
            <form id="doc-form">
              <AutoForm
                client:only="react"
                config={config}
                studio={studio}
                collectionSlug={collection}
                documentId={id && id !== "new" ? id : undefined}
              />
              <input type="hidden" id="form-data" name="form-data" value="{}" />
            </form>
          </div>
        </div>
      </div>
    </AdminLayout>
  )
}

<script>
  function setupEditorBrowser() {
    const browserDetails = document.getElementById("editor-browser-details") as HTMLDetailsElement | null;
    const browserBackdrop = document.getElementById("editor-browser-backdrop");
    browserBackdrop?.addEventListener("click", () => {
      browserDetails?.removeAttribute("open");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && browserDetails?.hasAttribute("open")) {
        browserDetails.removeAttribute("open");
      }
    });
  }
  setupEditorBrowser();
  document.addEventListener("astro:page-load", setupEditorBrowser);
</script>
