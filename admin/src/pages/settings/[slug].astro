---
import AdminLayout from "../../layouts/AdminLayout.astro";
import i18next from '../../lib/i18n';
import { globals } from "../../lib/config";
import { SettingsPage } from "../../components/SettingsPage";
import { getGlobal } from "../../lib/globals";

import { adminPath } from "../../lib/paths";
import { requireAuthServer } from "../../lib/auth-server";

const redirect = await requireAuthServer(Astro.request, { requireAdmin: true });
if (redirect) return redirect;

const slug = Astro.props.slug || Astro.params.slug || Astro.params.id;

// Validate global exists
if (!slug || !globals[slug]) {
  return Astro.redirect(adminPath);
}

const config = globals[slug];
const data = (await getGlobal(slug, { request: Astro.request })) || {};
const hasVersioning = !!config.versions;

const activeSlug = slug;
const allGlobals = Object.values(globals);

const title = config.label || slug;
const description =
  (config as any).admin?.description ||
  `Manage your ${title.toLowerCase()} configurations.`;
---

<AdminLayout title={`Settings - ${title}`}>
  <div class="settings-workspace">
    <aside class="settings-rail">
      <a class="settings-back" href={`${adminPath}/settings`}>← All settings</a>
      <nav aria-label="Site settings">{allGlobals.map(g => <a href={`${adminPath}/settings/${g.slug}`} data-global-tab={g.slug} aria-current={activeSlug === g.slug ? "page" : undefined}>{g.label || g.slug}</a>)}</nav>
    </aside>
    <section class="settings-panel">
      {!hasVersioning && <header class="workspace-page-header">
        <div class="workspace-title-row"><div><h1>{title}</h1><p class="workspace-description">{description}</p></div><button type="button" id="settings-save-btn" class="kyro-btn kyro-btn-md kyro-btn-primary">Save changes</button></div>
      </header>}
      <form id="settings-form">
        <input type="hidden" id="form-slug" value={slug} />
        <SettingsPage client:only="react" config={config} globalSlug={slug} layout={hasVersioning ? "split" : "single"} data={data} />
        <input type="hidden" id="form-data" name="form-data" value="{}" />
      </form>
    </section>
  </div>

  <script>
    const initSettingsPage = () => {
      console.log("[Astro] Settings page init");
      const saveBtn = document.getElementById("settings-save-btn");
      
      saveBtn?.addEventListener("click", () => {
        console.log("[Astro] Header save clicked");
        const btn = document.getElementById("btn-save");
        if (btn) {
          console.log("[Astro] Triggering hidden button click");
          btn.click();
        } else {
          console.error("[Astro] Hidden save button not found!");
        }
      });
    };

    const pruneGlobalTabs = (user?: any, permissions?: any) => {
      if (!user) {
        // @ts-ignore
        user = window.__kyroAuth?.user;
        // @ts-ignore
        permissions = window.__kyroAuth?.permissions;
      }
      if (!user) return;
      const userRole = user.role || "";
      const isAdmin = userRole === "admin" || userRole === "super_admin";

      const tabs = document.querySelectorAll("[data-global-tab]");
      tabs.forEach((tab) => {
        const globalSlug = tab.getAttribute("data-global-tab");
        if (!globalSlug) return;
        const hasRead = isAdmin || permissions?.globals?.[globalSlug]?.read === true;
        if (!hasRead) {
          (tab as HTMLElement).style.display = "none";
        } else {
          (tab as HTMLElement).style.display = "";
        }
      });
    };

    const runInitAndPrune = () => {
      initSettingsPage();
      pruneGlobalTabs();
    };

    document.addEventListener("astro:page-load", runInitAndPrune);
    runInitAndPrune();

    window.addEventListener("kyro:auth-ready", (event: any) => {
      const { user, permissions } = event.detail || {};
      pruneGlobalTabs(user, permissions);
    });

    // Global listeners should only be attached once
    // @ts-ignore
    if (!window.__kyroSettingsGlobalListenersAttached) {
      window.addEventListener("kyro:global-save-start", () => {
        const saveBtn = document.getElementById("settings-save-btn");
        if (saveBtn) {
          saveBtn.setAttribute("disabled", "true");
          saveBtn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>Saving...`;
          saveBtn.classList.add("opacity-50", "cursor-wait");
        }
      });

      window.addEventListener("kyro:global-save-end", () => {
        const saveBtn = document.getElementById("settings-save-btn");
        if (saveBtn) {
          saveBtn.removeAttribute("disabled");
          saveBtn.innerHTML = "Save Changes";
          saveBtn.classList.remove("opacity-50", "cursor-wait");
        }
      });
      // @ts-ignore
      window.__kyroSettingsGlobalListenersAttached = true;
    }
  </script>
</AdminLayout>
