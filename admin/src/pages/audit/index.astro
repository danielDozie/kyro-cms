---
import AdminLayout from '../../layouts/AdminLayout.astro';
import i18next from '../../lib/i18n';
import { AuditLogsPage } from '../../components/AuditLogsPage';

import { requireAuthServer } from '../../lib/auth-server';

const redirect = await requireAuthServer(Astro.request, { collectionRead: 'audit_logs' });
if (redirect) return redirect;
---

<AdminLayout title={i18next.t("pages.ActivityLog", { defaultValue: "Activity log" })}>
  <AuditLogsPage client:only="react">
    <p slot="fallback" role="status" class="text-sm text-[var(--kyro-text-secondary)]">Loading activity log…</p>
  </AuditLogsPage>
</AdminLayout>
