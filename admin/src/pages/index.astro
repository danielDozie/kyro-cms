---
import AdminLayout from "../layouts/AdminLayout.astro";
import i18next from "../lib/i18n";
import { collections, getActiveProjectFromRequest, authCollectionSlugs } from "../lib/config";
import { adminPath, apiPath } from "../lib/paths";
import { DashboardMetrics, RevenueChart } from "../components/DashboardMetrics";
import { CustomerDashboard } from "../components/CustomerDashboard";
import { AuthorDashboard } from "../components/AuthorDashboard";
import { RecentContent } from "../components/RecentContent";
import { DashboardQuickSections } from "../components/DashboardQuickSections";

import { getAuthServer } from "../lib/auth-server";

const { user: serverUser, permissions: serverPermissions } = await getAuthServer(Astro.request);
const serverRole = serverUser?.role || "";
const isServerSuperAdmin = serverRole === "super_admin";
const isServerAdmin = serverRole === "admin" || isServerSuperAdmin;
const isServerCustomer = serverRole === "customer";
const isServerAuthor = serverRole === "author";

const activeProject = getActiveProjectFromRequest(Astro.request);
const projectCollectionSlugs =
  activeProject?.collections && activeProject.collections.length > 0
    ? new Set(activeProject.collections)
    : null;

// Filter collections based on the active project/organization
const scopedCollections = projectCollectionSlugs
  ? Object.fromEntries(
      Object.entries(collections).filter(
        ([slug]) => projectCollectionSlugs.has(slug) || authCollectionSlugs.includes(slug),
      ),
    )
  : collections;

// Serialize collections for client-side role-based dashboards
const serializedCollections = JSON.parse(JSON.stringify(
  Object.fromEntries(
    Object.entries(scopedCollections).map(([slug, config]) => [slug, { label: (config as any).label || slug, slug }])
  )
));

// Editorial collections only; keep customer, order, and account data out of this table.
const recentCollections = Object.fromEntries(
  Object.entries(scopedCollections)
    .filter(([slug, config]) => !["users", "audit_logs", "media", "orders", "customers", "form-entries"].includes(slug) &&
      ((config as any).admin?.useAsTitle === "title" || ((config as any).fields || []).some((field: any) => field.name === "title")))
    .map(([slug, config]) => [slug, { label: (config as any).label || slug, titleField: (config as any).admin?.useAsTitle || "title" }])
);

const permittedQuickLinks = Object.entries(scopedCollections)
  .filter(([slug]) => !["users", "audit_logs", "media"].includes(slug))
  .filter(([slug]) => {
    if (!serverUser) return true;
    return isServerAdmin || serverPermissions?.collections?.[slug]?.create === true;
  })
  .slice(0, 6);

const isEcommerce = !!(scopedCollections["orders"] || scopedCollections["products"]);
const allowedCollectionsParam = activeProject?.collections?.length ? activeProject.collections.join(",") : "";

---

<AdminLayout title={i18next.t("pages." + "Dashboard".replace(/ /g, ""), { defaultValue: "Dashboard" })}>
  <div class="dashboard-page flex-1 space-y-8">
    {/* ── Role-Based Dashboard Fork ── */}
    {isServerCustomer ? (
      <CustomerDashboard
          client:only="react"
          collections={serializedCollections}
          userName={serverUser?.name || serverUser?.email || ""}
          userAvatar={serverUser?.avatar || ""}
          userId={serverUser?.id || ""}
        />
    ) : isServerAuthor ? (
     <AuthorDashboard
          client:only="react"
          collections={serializedCollections}
          userName={serverUser?.name || serverUser?.email || ""}
          userAvatar={serverUser?.avatar || ""}
          userId={serverUser?.id || ""}
        />
    ) : (
    <>
    <header class="dashboard-toolbar">
      <p class="dashboard-breadcrumb">Workspace <span>/</span> Overview</p>
      <div class="dashboard-search">
        <label class="sr-only" for="header-search-input">Search collections and content</label>
        <input type="search" id="header-search-input" placeholder="Search anything…" autocomplete="off" />
        <button type="button" id="cmd-k-btn" aria-label="Open command palette">⌘ K</button>
        <div id="header-search-results" class="hidden absolute top-full left-0 right-0 mt-2 bg-[var(--kyro-surface)] border border-[var(--kyro-border)] rounded-lg  max-h-80 overflow-y-auto z-50 p-1.5"></div>
      </div>
    </header>
    <div class="dashboard-heading">
      <div><h1>Overview</h1><p>Your site, at a glance.</p></div>
      {permittedQuickLinks.length > 0 && <a class="dashboard-create" href={`${adminPath}/${permittedQuickLinks[0][0]}/new`}><span aria-hidden="true">+</span> Create content</a>}
    </div>

    <!-- CMS Metrics -->
    <DashboardMetrics client:idle isEcommerce={isEcommerce} allowedCollections={activeProject?.collections && activeProject.collections.length > 0 ? activeProject.collections : undefined} />
    {isEcommerce && <RevenueChart client:only="react" />}


    <RecentContent client:only="react" collections={recentCollections} serverUserRole={serverRole} serverPermissions={serverPermissions} />

    <!-- Role-filtered Quick Actions & Explore Content -->
    <DashboardQuickSections
      client:only="react"
      collections={serializedCollections}
      serverUserRole={serverRole}
      serverPermissions={serverPermissions}
    />

    <script is:inline define:vars={{ apiPath, adminPath, allowedCollectionsParam }}>
      (function () {
        document.getElementById("cmd-k-btn")?.addEventListener("click", function () {
          window.openCommandPalette?.();
        });
        var searchInput = document.getElementById("header-search-input");
        var searchResults = document.getElementById("header-search-results");
        if (!searchInput || !searchResults) return;

        var debounceTimer = null;

        function renderResults(results) {
          var html = "";
          if (!results || results.length === 0) {
            html = '<div class="p-4 text-center text-sm text-[var(--kyro-text-secondary)] opacity-60">No documents found</div>';
          } else {
            for (var i = 0; i < Math.min(results.length, 8); i++) {
              var r = results[i];
              var href = adminPath + "/" + r.collection + "/" + r.id;
              if (r.collection === "users") {
                href = adminPath + "/users/" + r.id;
              }

              // Prefer human-readable name/label/title instead of raw ID
              var displayTitle = r.title;
              if (!displayTitle || displayTitle === r.id || /^[0-9a-fA-F-]{20,}$/.test(displayTitle)) {
                if (r.doc) {
                  displayTitle =
                    r.doc.name ||
                    r.doc.label ||
                    r.doc.title ||
                    r.doc.email ||
                    r.doc.fullName ||
                    r.doc.username ||
                    r.doc.heading ||
                    r.doc.slug ||
                    r.doc.filename ||
                    r.title ||
                    "Untitled";
                }
              }

              var collectionBadge = r.label || r.collection || "Document";

              html +=
                '<a href="' +
                href +
                '" class="flex items-center justify-between px-3.5 py-2.5 rounded-lg hover:bg-[var(--kyro-surface-accent)] transition-colors group">';
              html +=
                '<div class="flex flex-col min-w-0 pr-3">' +
                '<span class="font-semibold text-sm text-[var(--kyro-text-primary)] truncate group-hover:text-[var(--kyro-primary)] transition-colors">' +
                displayTitle +
                "</span>" +
                '<span class="text-[10px] font-bold tracking-wider uppercase opacity-45 mt-0.5">' +
                collectionBadge +
                "</span>" +
                "</div>";
              html +=
                '<span class="text-xs font-medium text-[var(--kyro-text-muted)] group-hover:text-[var(--kyro-primary)] transition-colors flex-shrink-0">View →</span>' +
                "</a>";
            }
          }
          searchResults.innerHTML = html;
          searchResults.classList.remove("hidden");
        }

        function hideResults() {
          searchResults.classList.add("hidden");
        }

        searchInput.addEventListener("input", function (e) {
          var query = e.target.value.trim();
          if (query.length < 2) {
            searchResults.classList.add("hidden");
            return;
          }
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function () {
            var xhr = new XMLHttpRequest();
            var collectionsQuery = allowedCollectionsParam ? "&collections=" + encodeURIComponent(allowedCollectionsParam) : "";
            xhr.open("GET", apiPath + "/search?q=" + encodeURIComponent(query) + "&limit=10" + collectionsQuery, true);
            xhr.onload = function () {
              if (xhr.status === 200) {
                try {
                  var data = JSON.parse(xhr.responseText);
                  if (data.results) renderResults(data.results);
                } catch (err) {
                  console.error(err);
                }
              }
            };
            xhr.send();
          }, 300);
        });

        searchInput.addEventListener("blur", function () {
          setTimeout(hideResults, 200);
        });

        document.addEventListener("click", function (e) {
          if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
            hideResults();
          }
        });
      })();
    </script>
    </>
    )}
  </div>
</AdminLayout>
