---
import AdminLayout from '../layouts/AdminLayout.astro';
import i18next from '../lib/i18n';
import { MediaLibraryView } from '../components/MediaLibraryView';

import { requireAuthServer } from '../lib/auth-server';

const redirect = await requireAuthServer(Astro.request, { collectionRead: 'media' });
if (redirect) return redirect;
---

<AdminLayout title={i18next.t("pages." + "Media Library".replace(/ /g, ""), { defaultValue: "Media Library" })}> 
  <div class="flex-1 flex flex-col h-full min-h-0 overflow-hidden -m-4 md:m-0">
    <MediaLibraryView client:only="react">
      <p slot="fallback" role="status" class="grid flex-1 place-items-center p-6 text-sm text-[var(--kyro-text-secondary)]">
        Loading media library…
      </p>
    </MediaLibraryView>
  </div>
</AdminLayout>
