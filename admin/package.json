{
  "name": "@kyro-cms/admin",
  "version": "0.12.23",
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Admin dashboard for Kyro CMS",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "node": "./src/index.node.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "import": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./hooks": {
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./plugins": {
      "import": "./src/plugins/index.ts",
      "default": "./src/plugins/index.ts"
    },
    "./plugins/seo-admin": {
      "import": "./src/plugins/seo-admin.tsx",
      "default": "./src/plugins/seo-admin.tsx"
    },
    "./blocks": {
      "import": "./src/blocks/index.ts",
      "default": "./src/blocks/index.ts"
    },
    "./fields": {
      "import": "./src/fields/index.ts",
      "default": "./src/fields/index.ts"
    },
    "./integration": {
      "import": "./src/integration.ts",
      "default": "./src/integration.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "build:pages": "CLOUDFLARE=true astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@graphiql/react": "^0.37.3",
    "@kyro-cms/astro": "workspace:*",
    "@kyro-cms/core": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/pg": "^8.20.0",
    "@uiw/codemirror-theme-aura": "^4.25.9",
    "@uiw/codemirror-theme-dracula": "^4.25.9",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@uiw/react-codemirror": "^4.25.9",
    "astro": "^7.1.1",
    "astro-loading-indicator": "^0.8.0",
    "dotenv": "^17.4.2",
    "graphiql": "^5.2.2",
    "i18next": "^26.3.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-image-crop": "^11.0.10",
    "recharts": "^3.9.2",
    "swup": "^4.9.0",
    "tailwindcss": "^4.0.0",
    "unstorage": "^1.17.5",
    "use-sync-external-store": "1.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^11.0.0",
    "i18next-parser": "^9.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@kyro-cms/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielDozie/kyro-cms"
  }
}