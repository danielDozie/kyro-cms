---
/**
 * Pure Astro Zero-JS Block Layout Page Builder Renderer for Kyro CMS.
 */
interface Props {
  blocks: Array<{ blockType: string; [key: string]: any }>;
  class?: string;
}

const { blocks = [], class: className = '' } = Astro.props;
---

<div class={`kyro-blocks ${className}`}>
  {blocks.map((block, index) => (
    <section key={index} class={`kyro-block kyro-block-${block.blockType}`}>
      <slot name={block.blockType} block={block}>
        <div class="p-4 border border-dashed border-stone-300 rounded my-2">
          <p class="text-xs font-mono text-stone-500">Block: {block.blockType}</p>
        </div>
      </slot>
    </section>
  ))}
</div>
